# ============================================================================
# CCTV People Counter - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# Usage: cp .env.example .env
#
# IMPORTANT: NEVER commit .env file to version control!
# Add .env to .gitignore

# ============================================================================
# DATABASE CREDENTIALS (PostgreSQL)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=face_recognition
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ============================================================================
# CAMERA RTSP URLs
# ============================================================================
# Format: rtsp://username:password@ip_address:port/stream_path
#
# SECURITY: Store camera credentials here instead of config files
# Each camera should have its own environment variable

# Main Camera (Default)
CAMERA_MAIN_URL=rtsp://admin:password@192.168.1.100:554/stream1

# Organization 1 Cameras (e.g., Company A)
CAMERA_ENTRANCE_URL=rtsp://admin:password@192.168.1.101:554/stream1
CAMERA_EXIT_URL=rtsp://admin:password@192.168.1.102:554/stream1
CAMERA_LOBBY_A_URL=rtsp://admin:password@192.168.1.103:554/stream1

# Organization 2 Cameras (e.g., Company B)
CAMERA_LOBBY_B_URL=rtsp://admin:password@192.168.1.104:554/stream1
CAMERA_OFFICE_B_URL=rtsp://admin:password@192.168.1.105:554/stream1

# For webcam testing, use: 0
# CAMERA_MAIN_URL=0

# ============================================================================
# API SERVER CONFIGURATION (Optional)
# ============================================================================

# API server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
# API_HOST=0.0.0.0

# API server port
# API_PORT=5000

# Enable debug mode (true/false)
# API_DEBUG=false

# ============================================================================
# FACE RECOGNITION CONFIGURATION (Optional)
# ============================================================================

# Face recognition confidence threshold (0.0 - 1.0)
# Lower = stricter matching, Higher = looser matching
# FACE_CONFIDENCE_THRESHOLD=0.6

# ============================================================================
# LOGGING CONFIGURATION (Optional)
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Log file path
# LOG_FILE=logs/app.log
