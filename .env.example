# CCTV People Counter - Environment Variables
# Copy this file to .env and fill in your actual values
# Usage: cp .env.example .env

# ============================================================================
# CAMERA CONFIGURATION
# ============================================================================

# RTSP Camera URL
# Format: rtsp://username:password@ip:port/stream_path
# Example: rtsp://admin:password123@192.168.1.100:554/stream1
RTSP_URL=rtsp://username:password@192.168.1.100:554/stream1

# For webcam, use: 0 (or leave RTSP_URL commented out)
# RTSP_URL=0

# ============================================================================
# DATABASE CONFIGURATION (Optional)
# ============================================================================

# Database file path
# DB_PATH=people_counter.db

# ============================================================================
# API SERVER CONFIGURATION (Optional)
# ============================================================================

# API server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
# API_HOST=0.0.0.0

# API server port
# API_PORT=5000

# Enable debug mode (true/false)
# API_DEBUG=false

# ============================================================================
# FACE RECOGNITION CONFIGURATION (Optional)
# ============================================================================

# Face recognition confidence threshold (0.0 - 1.0)
# Lower = stricter matching, Higher = looser matching
# FACE_CONFIDENCE_THRESHOLD=0.6

# ============================================================================
# LOGGING CONFIGURATION (Optional)
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Log file path
# LOG_FILE=logs/app.log
